# Browser API base URL. In dev, /api is proxied to the Go API by Vite (see vite.config.ts).
VITE_API_URL=/api

# Optional: override Go API target for the Vite dev proxy (server-side only, not VITE_*)
# API_PROXY_TARGET=http://localhost:8080

# Set to "true" once GET /jobs is available — hooks stay disabled until then
VITE_ENABLE_API=false
